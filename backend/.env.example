# ProjectsManagerWebV2 Backend Environment Variables
# Copy to .env and update values

# Server
HOST=0.0.0.0
PORT=8401

# Database
DATABASE_URL=sqlite+aiosqlite:///./codeboard.db

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8501

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=your-api-key-here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3601

# Environment
ENVIRONMENT=development
DEBUG=true
