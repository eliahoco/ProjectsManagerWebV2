// Projects Manager Web - Database Schema
// Migrated from ports.db SQLite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String      @id @default(cuid())
  name        String      @unique
  path        String
  status      String      @default("ACTIVE") // ACTIVE, DEPRECATED, ARCHIVED
  description String?
  type        String?     // nodejs, python, go, rust, etc.
  version     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  ports           Port[]
  sessions        Session[]
  issues          Issue[]     // CodeBoard issues
  qaSettings      QASettings? // QA Board settings
  watchdogEnabled Boolean     @default(false)
  watchdogEvents  WatchdogEvent[]
  autopilotQueues AutoPilotQueueRecord[]
  // CB-2384 Studio
  studioSessions  StudioSession[]
  backlogItems    BacklogItem[]
  crewAssignments CrewAssignment[]
  // Git integration
  commitLinks     CommitLink[]
  gitSyncState    GitSyncState?
  // Issue Groups
  issueGroups     IssueGroup[]
}

model Port {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  port         Int
  serviceName  String
  serviceType  String   // FRONTEND, BACKEND, DATABASE, CACHE, QUEUE, MONITORING, OTHER
  protocol     String   @default("TCP") // TCP, UDP
  internalPort Int?
  url          String?
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([port, protocol])
  @@index([projectId])
}

model PortRange {
  id          String  @id @default(cuid())
  serviceType String  @unique
  rangeStart  Int
  rangeEnd    Int
  description String?
}

model Session {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  lastDone  String?   // Summary of what was done
  nextSteps String?   // Planned next steps

  @@index([projectId])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ============================================
// CodeBoard - Issue Tracking Models
// ============================================

model Issue {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Issue identification
  key         String   @unique  // e.g., "PROJ-123"
  sequence    Int               // Sequential number within project

  // Issue details
  title       String
  description String?
  type        String   @default("TASK")    // EPIC, STORY, TASK, SUBTASK, BUG
  status      String   @default("BACKLOG") // BACKLOG, TODO, IN_PROGRESS, IN_REVIEW, COMPLETED_WAITING_QA, DONE, CANCELLED
  priority    String   @default("MEDIUM")  // LOW, MEDIUM, HIGH, CRITICAL

  // Hierarchy
  parentId    String?
  parent      Issue?   @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Issue[]  @relation("IssueHierarchy")

  // Assignments
  assignee    String?  // User name or ID
  reporter    String?  // User name or ID

  // Estimation & tracking
  storyPoints Int?
  estimate    Float?   // Hours estimated
  timeSpent   Float?   // Hours spent

  // Dates
  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  comments     Comment[]
  activities   Activity[]
  linkedFrom   IssueLink[] @relation("LinkedFrom")
  linkedTo     IssueLink[] @relation("LinkedTo")
  qaTaskLinks  QATaskIssueLink[]  // QA tasks testing this issue

  // Metadata
  labels           String?  // JSON array of labels
  breakdownBatchId String?  // UUID to group issues created in same AI breakdown

  // Implementation Documentation
  implementationSummary String?   // Markdown: what was actually built
  technicalApproach     String?   // JSON: tech stack, patterns used
  documentationPath     String?   // Path to MD file: /docs/features/CB-851.md

  // Enhanced Metadata
  estimatedHours        Float?    // Estimated hours
  actualHours           Float?    // Actual hours spent
  complexity            String?   // LOW, MEDIUM, HIGH, CRITICAL

  // AI Context — free-text guidance for AI agents during execution
  // Embedded into ChromaDB for RAG retrieval from ancestor issues
  aiContext             String?

  // Relations - Implementation Documentation
  executionSummaries    ExecutionSummary[]
  implementationNotes   ImplementationNote[]
  // CB-2384 Crew Map
  crewAssignments       CrewAssignment[]
  // Git integration
  commitLinks           CommitLink[]
  // Issue Groups
  groupMemberships      IssueGroupMember[]
  // Pipeline
  pipelineExecutions    PipelineExecution[]

  @@index([projectId])
  @@index([breakdownBatchId])
  @@index([parentId])
  @@index([status])
  @@index([type])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  author    String   // User name or ID
  content   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
}

model Activity {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  actor     String   // User or system that performed the action
  action    String   // CREATED, UPDATED, STATUS_CHANGED, ASSIGNED, COMMENTED, etc.
  field     String?  // Field that was changed (for UPDATED actions)
  oldValue  String?  // Previous value
  newValue  String?  // New value

  createdAt DateTime @default(now())

  @@index([issueId])
}

model IssueLink {
  id           String @id @default(cuid())
  fromIssueId  String
  fromIssue    Issue  @relation("LinkedFrom", fields: [fromIssueId], references: [id], onDelete: Cascade)
  toIssueId    String
  toIssue      Issue  @relation("LinkedTo", fields: [toIssueId], references: [id], onDelete: Cascade)

  linkType     String // BLOCKS, IS_BLOCKED_BY, RELATES_TO, DUPLICATES, IS_DUPLICATED_BY, CAUSED_BY, CAUSES

  createdAt    DateTime @default(now())

  @@unique([fromIssueId, toIssueId, linkType])
  @@index([fromIssueId])
  @@index([toIssueId])
}

model IssueSequence {
  id         String @id @default(cuid())
  projectId  String @unique
  prefix     String // e.g., "PROJ", "CB"
  lastNumber Int    @default(0)

  @@index([projectId])
}

// ============================================
// QA Board - Quality Assurance Testing Models
// ============================================

model QATask {
  id              String    @id @default(cuid())
  projectId       String

  // Task identification
  key             String    @unique  // e.g., "QA-001", "QA-002"
  sequence        Int                // Sequential number

  // Task details
  title           String
  scenario        String             // Test steps (markdown)
  expectedResult  String
  actualResult    String?            // Filled after execution

  // Status and type
  // status: NOT_DONE, IN_PROGRESS, PASS, FAILED
  status          String    @default("NOT_DONE")
  // type: AUTOMATED, MANUAL
  type            String    @default("AUTOMATED")
  // priority: LOW, MEDIUM, HIGH, CRITICAL
  priority        String    @default("MEDIUM")

  // Execution history (JSON - last 10 full runs, summaries for older)
  executionHistory String?

  // Timestamps
  lastExecutedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  linkedIssues    QATaskIssueLink[]

  // Optional link to bug created from failure
  bugIssueId      String?

  // Enhanced Linking for Documentation
  linkedFeatureId     String?   // Direct link to feature being tested
  linkedEpicId        String?
  linkedStoryId       String?
  linkedTaskId        String?

  // Context for RAG
  testContext         String?   // JSON: relevant docs, architecture notes

  // Results Context
  failureContext      String?   // JSON: what was happening when it failed
  environmentDetails  String?   // JSON: environment config during test

  @@index([projectId])
  @@index([status])
  @@index([priority])
}

model QATaskIssueLink {
  id        String   @id @default(cuid())
  qaTaskId  String
  qaTask    QATask   @relation(fields: [qaTaskId], references: [id], onDelete: Cascade)
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([qaTaskId, issueId])
  @@index([qaTaskId])
  @@index([issueId])
}

model QASequence {
  id         String @id @default(cuid())
  projectId  String @unique
  prefix     String @default("QA")
  lastNumber Int    @default(0)

  @@index([projectId])
}

model QASettings {
  id                String  @id @default(cuid())
  projectId         String  @unique
  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  passThreshold     Float   @default(0.9)  // 90% pass threshold
  autoCreateBugs    Boolean @default(true)
}

// ============================================
// Documentation & Implementation Notes Models
// ============================================

model ImplementationNote {
  id          String   @id @default(cuid())
  issueId     String
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  // Note content
  title       String            // Short title for the note
  content     String            // Markdown content
  category    String   @default("GENERAL") // DECISION, APPROACH, TRADEOFF, DEPENDENCY, RISK, LESSON, GENERAL
  author      String   @default("System")  // Who wrote the note

  // Optional metadata
  tags        String?           // JSON array of tags for filtering
  references  String?           // JSON array of related file paths or URLs
  importance  String   @default("MEDIUM")  // LOW, MEDIUM, HIGH

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([issueId])
  @@index([category])
  @@index([issueId, category])
}

model ExecutionSummary {
  id                  String    @id @default(cuid())
  issueId             String
  issue               Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)

  // Execution Metadata
  summary             String    // Markdown summary
  executedAt          DateTime
  executionTime       Float     // Seconds
  provider            String    // claude_code, ollama
  model               String?   // claude-3-opus, etc.
  exitCode            Int?

  // Implementation Details
  componentsModified  String    // JSON: ["frontend", "backend", "database"]
  filesTouched        String    // JSON: ["src/app.tsx", "api/route.ts"]
  linesAdded          Int?
  linesRemoved        Int?

  // Documentation
  architectureNotes   String?   // Architectural decisions made
  technicalNotes      String?   // Technical implementation notes
  challengesFaced     String?   // Challenges and how resolved
  lessonsLearned      String?   // Learnings for future reference

  // Linked Artifacts
  commitHashes        String?   // JSON array of commit hashes
  docFilePath         String?   // Path to generated MD file

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([issueId])
  @@index([executedAt])
}

model FeatureDocumentation {
  id                  String    @id @default(cuid())
  projectId           String
  featureIssueId      String
  featureKey          String    // CB-851

  // Documentation Content
  title               String
  overview            String    // High-level summary
  requirements        String    // Original requirements
  implementation      String    // What was built
  architecture        String    // Architecture decisions
  techStack           String    // JSON: technologies used
  testingStrategy     String    // QA approach

  // Metrics
  totalTasks          Int
  completedTasks      Int
  totalQATasks        Int
  passedQATasks       Int
  failedQATasks       Int

  // File Reference
  mdFilePath          String    // /docs/features/CB-851.md

  // Indexing for RAG
  embeddingId         String?   // ChromaDB document ID
  lastIndexedAt       DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([projectId])
  @@index([featureIssueId])
  @@index([featureKey])
}

// ============================================
// Agent Profiles
// ============================================

model AgentProfile {
  id               String   @id @default(cuid())
  name             String   @unique
  displayName      String
  description      String?
  agentPath        String
  capabilities     String?  // JSON array
  issueTypeAffinity String? // JSON array
  projectPatterns  String?  // JSON array
  isActive         Boolean  @default(true)
  priority         Int      @default(50)
  // "standalone" = ~/.claude/agents; "plugin:<name>" = from plugin cache
  source           String   @default("standalone")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
  @@index([source])
}

// ============================================
// Skill Profiles
// ============================================

model SkillProfile {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g. "jonny", "atlas", "skill-creator"
  displayName String            // e.g. "Jonny", "Atlas"
  description String?           // From frontmatter `description:` field
  skillPath   String            // Absolute path to SKILL.md

  capabilities String?  // JSON array — from frontmatter `capabilities:`
  contextFork  Boolean  @default(false)  // true if frontmatter has `context: fork`
  agentRef     String?  // Value of `agent:` key if present, e.g. "atlas-indexer"

  // "standalone" = ~/.claude/skills; "plugin:<name>" = from plugin cache
  source    String  @default("standalone")

  isActive  Boolean  @default(true)
  priority  Int      @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([source])
}

// ============================================
// Watchdog - Service Auto-Restart Tracking
// ============================================

model WatchdogEvent {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  port        Int
  serviceName String
  action      String   // RESTART_ATTEMPTED, RESTART_SUCCESS, RESTART_FAILED, MAX_RETRIES_EXCEEDED
  attempt     Int
  error       String?
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

// ============================================
// AutoPilot — Queue Persistence Models
// ============================================

model AutoPilotQueueRecord {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  featureId     String?       // Optional: the FEATURE issue this queue is running
  status        String        // pending|running|paused|waiting_reset|completed|aborted
  currentIndex  Int       @default(0)
  pauseReason   String?       // token_exhaustion|crash_recovery|manual
  resetTime     DateTime?     // When auto-resume should fire (token exhaustion case)
  config        String        // JSON blob: model, retries, etc.
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?
  tasks         AutoPilotTaskRecord[]
  events        AutoPilotEvent[]

  // CB-2748: persistence overhaul additions
  state             String?   // canonical state enum value (mirrors status)
  stateReason       String?   // enum reason: crash_recovery|disk_full|manual|etc.
  lastCheckpointAt  DateTime? // UTC of last successful _checkpoint() call
  recoveryGeneration Int      @default(0)  // incremented on each crash recovery

  // CB-2794: persisted circuit-breaker counter — survives backend restarts
  autoResumeAttempts Int      @default(0)

  @@index([projectId, status])
  @@index([status])
}

model AutoPilotTaskRecord {
  id            String    @id @default(cuid())
  queueId       String
  queue         AutoPilotQueueRecord @relation(fields: [queueId], references: [id], onDelete: Cascade)
  sequence      Int           // Position within queue
  issueId       String        // The issue being executed (CodeBoard Issue.id)
  // CB-2673: persisted so rehydrated tasks have populated key/title without a JOIN
  issueKey      String?       // e.g. "CB-1234"
  issueTitle    String?       // Human-readable title for display + audit log
  status        String        // pending|running|completed|failed|skipped
  attempts      Int       @default(0)
  sessionId     String?       // terminal_service session id for the latest attempt
  startedAt     DateTime?
  completedAt   DateTime?
  failureReason String?

  // CB-2748: persistence overhaul additions
  lastProgressAt  DateTime? // last tick where files_*/commands_run changed
  subprocessPid   Int?      // PID of live claude subprocess; cleared on finish

  @@index([queueId, sequence])
  @@index([issueId])
}

model AutoPilotEvent {
  id        String    @id @default(cuid())
  queueId   String
  queue     AutoPilotQueueRecord @relation(fields: [queueId], references: [id], onDelete: Cascade)
  // CB-2748: extended type set — see AutoPilotEventType in backend/models/autopilot.py
  type      String        // created|task_started|task_completed|task_failed|auto_paused|manual_paused|resumed|auto_resume_scheduled|auto_resume_fired|aborted|crash_recovery_detected|STATE_TRANSITION|CHECKPOINT_WRITTEN|RECOVERY_STARTED|RECOVERY_COMPLETED|ZOMBIE_DETECTED|TOKEN_EXHAUSTION_DETECTED|AUTO_RESUME_SCHEDULED|AUTO_RESUME_FIRED|PERSIST_FAILED|DISK_FULL_DETECTED|SUBPROCESS_PID_RECORDED
  payload   String        // JSON blob with event-specific fields
  createdAt DateTime  @default(now())

  @@index([queueId, createdAt])
  @@index([type, createdAt])
}

// ============================================
// Studio — CB-2384
// ============================================

model StudioSession {
  id             String    @id @default(cuid())
  tenantId       String?
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  // ACTIVE | PAUSED | HIBERNATED | COMPLETED | FAILED
  status         String    @default("ACTIVE")
  planningState  String    @default("{}") // JSON blob
  lastMessageAt  DateTime?
  tokenBudget    Int       @default(50000)
  tokensUsed     Int       @default(0)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages        StudioMessage[]
  toolCalls       StudioToolCall[]
  subAgentRuns    StudioSubAgentRun[]
  artifacts       StudioArtifact[]
  hierarchyDrafts StudioHierarchyDraft[]
  agentActivities StudioAgentActivity[]
  agentInstances  AgentInstance[]
  backlogItems    BacklogItem[]         @relation("SessionBacklogItems")

  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@index([tenantId, projectId])
  @@index([projectId, status])
}

model StudioMessage {
  id           String        @id @default(cuid())
  tenantId     String?
  sessionId    String
  session      StudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequenceNum  Int
  // USER | ASSISTANT | TOOL_RESULT | SUB_AGENT
  role         String
  content      String        // JSON blob
  model        String?
  tokensInput  Int           @default(0)
  tokensOutput Int           @default(0)
  costUsd      Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  toolCalls    StudioToolCall[]    @relation("MessageToolCalls")
  subAgentRuns StudioSubAgentRun[] @relation("ParentMessageSubAgentRuns")

  @@unique([sessionId, sequenceNum])
  @@index([sessionId])
  @@index([tenantId])
  @@index([sessionId, sequenceNum])
}

model StudioToolCall {
  id          String         @id @default(cuid())
  tenantId    String?
  sessionId   String
  session     StudioSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId   String?
  message     StudioMessage? @relation("MessageToolCalls", fields: [messageId], references: [id], onDelete: SetNull)
  toolName    String
  input       String         // JSON blob
  output      String?        // JSON blob
  // PENDING | RUNNING | COMPLETED | FAILED
  status      String         @default("PENDING")
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([sessionId])
  @@index([messageId])
  @@index([tenantId])
  @@index([status])
}

model StudioSubAgentRun {
  id               String         @id @default(cuid())
  tenantId         String?
  sessionId        String
  session          StudioSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parentMessageId  String?
  parentMessage    StudioMessage? @relation("ParentMessageSubAgentRuns", fields: [parentMessageId], references: [id], onDelete: SetNull)
  // RESEARCHER | DESIGNER | BREAKDOWN_WRITER | AUDITOR
  agentRole        String
  inputSnapshot    String         // JSON blob
  outputSnapshot   String?        // JSON blob
  // PENDING | RUNNING | DONE | FAILED
  status           String         @default("PENDING")
  model            String
  tokensInput      Int            @default(0)
  tokensOutput     Int            @default(0)
  costUsd          Float          @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([sessionId])
  @@index([parentMessageId])
  @@index([tenantId])
  @@index([status])
  @@index([agentRole])
}

model StudioArtifact {
  id          String        @id @default(cuid())
  tenantId    String?
  sessionId   String
  session     StudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name        String
  // MARKDOWN | MERMAID | CODE | HTML | HIERARCHY_JSON | IMAGE | OTHER
  kind        String
  content     String?       // inline up to 64 KB
  storageUrl  String?
  sizeBytes   Int           @default(0)
  sha256      String
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  backlogItems BacklogItem[] @relation("ArtifactBacklogItems")

  @@index([sessionId])
  @@index([tenantId])
  @@index([kind])
  @@index([sha256])
}

model StudioHierarchyDraft {
  id                  String        @id @default(cuid())
  tenantId            String?
  sessionId           String
  session             StudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tree                String        // JSON blob
  // DRAFT | REVIEWING | APPROVED | PROMOTED | FAILED
  status              String        @default("DRAFT")
  promotedToFeatureId String?
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([sessionId])
  @@index([tenantId])
  @@index([status])
  @@index([sessionId, status])
}

model StudioAgentActivity {
  id          String        @id @default(cuid())
  tenantId    String?
  sessionId   String
  session     StudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // NOTIFY | REQUEST | DELEGATE | BROADCAST
  verb        String
  sourceAgent String
  targetAgent String?
  payload     String        // JSON blob
  chainDepth  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([sessionId])
  @@index([tenantId])
  @@index([verb])
  @@index([sessionId, createdAt])
}

// ============================================
// Agent Runtime — CB-2384
// ============================================

model AgentTemplate {
  id           String    @id @default(cuid())
  tenantId     String?
  key          String
  version      Int
  systemPrompt String
  tools        String    // JSON blob
  modelDefault String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  instances       AgentInstance[]
  crewAssignments CrewAssignment[]

  @@unique([key, version])
  @@index([tenantId])
  @@index([key])
  @@index([key, version])
}

model AgentInstance {
  id         String         @id @default(cuid())
  tenantId   String?
  sessionId  String?
  session    StudioSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  templateId String
  template   AgentTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  memory     String         @default("{}") // JSON blob
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([sessionId])
  @@index([templateId])
  @@index([tenantId])
  @@index([tenantId, sessionId])
}

model TenantTokenUsage {
  id             String    @id @default(cuid())
  tenantId       String?
  date           DateTime
  tokensInput    Int       @default(0)
  tokensOutput   Int       @default(0)
  costUsd        Float     @default(0)
  modelBreakdown String    @default("{}") // JSON blob
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId])
  @@index([date])
  @@index([tenantId, date])
}

// ============================================
// Backlog — CB-2384
// ============================================

model BacklogItem {
  id                  String         @id @default(cuid())
  tenantId            String?
  projectId           String
  project             Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  // LOW | MEDIUM | HIGH | CRITICAL
  priority            String         @default("MEDIUM")
  // DRAFT | REVIEWING | APPROVED | SCHEDULED | PROMOTED | SHIPPED | ARCHIVED
  status              String         @default("DRAFT")
  scheduledFor        DateTime?
  cronExpression      String?
  sourceSessionId     String?
  sourceSession       StudioSession? @relation("SessionBacklogItems", fields: [sourceSessionId], references: [id], onDelete: SetNull)
  sourceArtifactId    String?
  sourceArtifact      StudioArtifact? @relation("ArtifactBacklogItems", fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  promotedToFeatureId String?
  promoteJobId        String?
  ownerEmail          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  comments   BacklogComment[]
  activities BacklogActivity[]

  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([sourceSessionId])
  @@index([tenantId, projectId])
  @@index([projectId, status])
  @@index([scheduledFor])
}

model BacklogComment {
  id        String      @id @default(cuid())
  tenantId  String?
  itemId    String
  item      BacklogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author    String
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([itemId])
  @@index([tenantId])
}

model BacklogActivity {
  id        String      @id @default(cuid())
  tenantId  String?
  itemId    String
  item      BacklogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  action    String
  payload   String      @default("{}") // JSON blob
  actor     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([itemId])
  @@index([tenantId])
  @@index([itemId, createdAt])
}

// ============================================
// Crew Map — CB-2384
// ============================================

model CrewAssignment {
  id              String        @id @default(cuid())
  tenantId        String?
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id])
  issueId         String
  issue           Issue         @relation(fields: [issueId], references: [id])
  agentTemplateId String
  agentTemplate   AgentTemplate @relation(fields: [agentTemplateId], references: [id])
  roleLabel       String
  // ASSIGNED | ACTIVE | PAUSED | RELEASED
  status          String        @default("ASSIGNED")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  skillUsages CrewSkillUsage[]

  @@index([tenantId])
  @@index([projectId])
  @@index([issueId])
  @@index([agentTemplateId])
  @@index([status])
  @@index([tenantId, projectId])
  @@index([projectId, status])
}

model CrewSkillUsage {
  id               String         @id @default(cuid())
  tenantId         String?
  assignmentId     String
  assignment       CrewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  skillName        String
  invocationCount  Int            @default(0)
  lastUsedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([assignmentId])
  @@index([tenantId])
  @@index([skillName])
  @@index([assignmentId, skillName])
}

// ============================================
// Backend-only models mirrored to prevent schema drift
// These tables are created by SQLAlchemy (init_db) and exist in the DB.
// Adding them here so prisma db push does not drop them.
// ============================================

model CommitLink {
  id                   String   @id @default(cuid())
  issueId              String
  issue                Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commitHash           String
  shortHash            String
  message              String
  author               String
  authorEmail          String?
  committedAt          DateTime
  linkType             String   @default("MENTIONS")
  autoLinked           Boolean  @default(true)
  triggeredStatusChange Boolean @default(false)
  createdAt            DateTime @default(now())

  @@unique([issueId, commitHash])
  @@index([issueId])
  @@index([projectId])
  @@index([commitHash])
  @@index([author])
  @@index([projectId, author])
  @@index([committedAt])
  @@index([projectId, committedAt])
}

model GitSyncState {
  id                      String   @id @default(cuid())
  projectId               String   @unique
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastSyncedCommitHash    String?
  lastSyncedAt            DateTime?
  totalCommitsLinked      String   @default("0")
  totalStatusUpdates      String   @default("0")
  autoSyncEnabled         Boolean  @default(true)
  autoStatusUpdateEnabled Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([projectId])
}

model IssueGroup {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members IssueGroupMember[]

  @@index([projectId])
}

model IssueGroupMember {
  id        String     @id @default(cuid())
  groupId   String
  group     IssueGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  issueId   String
  issue     Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  position  Int        @default(0)
  createdAt DateTime   @default(now())

  @@unique([groupId, issueId])
  @@index([groupId])
  @@index([issueId])
}

model DocSettings {
  key           String   @id
  autoGenerate  Boolean  @default(true)
  retentionDays Int      @default(90)
  maxPerIssue   Int      @default(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PipelineExecution {
  id                String    @id @default(cuid())
  issueId           String
  issue             Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  projectId         String
  projectPath       String?
  agentId           String?
  status            String    @default("PENDING")
  currentStageIndex Int       @default(0)
  maxRetries        Int       @default(3)
  retryCount        Int       @default(0)
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  stages PipelineStage[]

  @@index([issueId])
  @@index([projectId])
  @@index([status])
}

model PipelineStage {
  id          String            @id @default(cuid())
  executionId String
  execution   PipelineExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stageType   String
  stageIndex  Int
  status      String            @default("PENDING")
  sessionId   String?
  error       String?
  inputData   String?
  resultData  String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())

  @@index([executionId])
}

model PipelineConfig {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  enableVerification  Boolean  @default(true)
  enableAutoFix       Boolean  @default(true)
  maxRetries          Int      @default(3)
  verificationTimeout Int      @default(120)
  defaultAgentId      String?
  verificationRules   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([projectId])
}

model park_events {
  id                  String   @id
  project_id          String
  parked_at           DateTime?
  services_snapshot   String?
  ai_sessions_stopped Int      @default(0)
  pipelines_cancelled Int      @default(0)
  parking_steps_log   String?
  duration_ms         Int?

  @@index([project_id])
}
